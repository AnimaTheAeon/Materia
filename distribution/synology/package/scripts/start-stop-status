#!/bin/sh
# DSM service control for Materia.
PID_FILE="$SYNOPKG_PKGVAR/materia.pid"
BIN="$SYNOPKG_PKGDEST/bin/Prowlarr"

is_running() {
	[ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

case "$1" in
	start)
		is_running && exit 0
		# DSM has no ICU library; .NET runs fine without it.
		export DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
		export HOME="$SYNOPKG_PKGVAR"
		nohup "$BIN" -nobrowser -data="$SYNOPKG_PKGVAR" >> "$SYNOPKG_PKGVAR/service.out" 2>&1 < /dev/null &
		echo $! > "$PID_FILE"
		i=0
		while [ $i -lt 20 ]; do
			is_running && exit 0
			sleep 0.25
			i=$((i + 1))
		done
		exit 1
		;;
	stop)
		if is_running; then
			PID="$(cat "$PID_FILE")"
			kill -TERM "$PID" 2>/dev/null
			i=0
			while [ $i -lt 60 ] && kill -0 "$PID" 2>/dev/null; do
				sleep 0.25
				i=$((i + 1))
			done
			kill -KILL "$PID" 2>/dev/null
		fi
		rm -f "$PID_FILE"
		exit 0
		;;
	status)
		is_running && exit 0
		exit 3
		;;
	log)
		echo "$SYNOPKG_PKGVAR/logs/prowlarr.txt"
		exit 0
		;;
esac
exit 0
